# ============================================================
# Backend .env.sample
# Course Selling App — Node.js / Express
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ============================================================


# ---- Server ----
PORT=8080


# ---- MongoDB (Atlas) ----
# Full connection string from your Atlas dashboard
# e.g. mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net


# ---- JWT Secrets ----
# Use a long, random string (e.g. openssl rand -hex 64)
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=7d


# ---- Google OAuth ----
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com


# ---- Cloudinary (Images) ----
# Used by src/utils/cloudinary.js for image uploads
CLOUDINARY_1_API_KEY=your_cloudinary_image_api_key
CLOUDINARY_1_API_SECRET=your_cloudinary_image_api_secret
# Note: cloud_name for images is currently hardcoded in cloudinary.js — consider moving it here


# ---- Cloudinary (Videos) ----
# Used by src/utils/video.cloudinary.js for video uploads
CLOUDINARY_2_API_KEY=your_cloudinary_video_api_key
CLOUDINARY_2_API_SECRET=your_cloudinary_video_api_secret
# Note: cloud_name for videos is currently hardcoded in video.cloudinary.js — consider moving it here


# ---- CORS ----
# Comma-separated list of allowed origins
# For local dev: http://localhost:5173,http://localhost:3000
# For production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
