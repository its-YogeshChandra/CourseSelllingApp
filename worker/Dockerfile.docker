# syntax=docker/dockerfile:1.7
FROM rust:1.88-slim-bookworm AS build

WORKDIR /app

RUN apt-get update   && apt-get install -y --no-install-recommends ca-certificates pkg-config libssl-dev   && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
RUN --mount=type=cache,id=worker-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=worker-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=worker-target,target=/app/target \
    mkdir -p src \
    && printf 'fn main() {}\n' > src/main.rs \
    && cargo build --release \
    && rm -rf src

COPY src ./src
RUN --mount=type=cache,id=worker-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=worker-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=worker-target,target=/app/target \
    touch src/main.rs \
    && cargo build --release \
    && cp /app/target/release/worker /usr/local/bin/worker

FROM debian:bookworm-slim AS runtime

RUN apt-get update   && apt-get install -y --no-install-recommends ca-certificates ffmpeg libssl3   && rm -rf /var/lib/apt/lists/*   && useradd --system --uid 10001 --create-home --home-dir /app worker

WORKDIR /app
COPY --from=build /usr/local/bin/worker /usr/local/bin/worker

USER worker

ENV RUST_LOG=info     WORKER_COUNT=2

CMD ["/usr/local/bin/worker"]
