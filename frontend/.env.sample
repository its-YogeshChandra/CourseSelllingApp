# ============================================================
# Frontend .env.sample
# Course Selling App — Vite / React
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
#
# ⚠️  VITE_* variables are BAKED IN at build time.
#     Changing them after build has NO effect.
#
# LOCAL DEV:  set full URLs  →  http://localhost:8080/api/v1/...
# DOCKER/PROD: use relative paths  →  /api/v1/...
#              (nginx proxy routes /api/ to the backend container)
# ============================================================


# ---- Google OAuth ----
# From Google Cloud Console → APIs & Services → Credentials
# Must match the GOOGLE_CLIENT_ID in the backend .env
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com


# ---- Clerk (if used) ----
# From your Clerk dashboard → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here


# ============================================================
# API Endpoint URLs
# For local dev change the base to: http://localhost:8080
# For Docker / production keep as relative paths: (empty base)
# ============================================================

# ---- Auth ----
VITE_LOGIN_USER=/api/v1/users/login
VITE_SIGNUP_USER=/api/v1/users/signup
VITE_GOOGLE_USER=/api/v1/users/googleLogin
VITE_AUTHME_URL=/api/v1/users/authme
VITE_LOGOUT_USER=/api/v1/users/logout

# ---- User Profile ----
VITE_FINDUSER_URL=/api/v1/users/findUser
VITE_UPDATEPASSWORD_URL=/api/v1/users/updatepassword
VITE_UPDATEPROFILE_URL=/api/v1/users/updateprofile

# ---- Course Progress ----
VITE_COURSE_ADDTOCOMPLETION_URL=/api/v1/users/addtocompletion
VITE_COURSE_CHECKCOMPLETION_URL=/api/v1/users/completioncheck

# ---- Courses ----
VITE_COURSE_URL=/api/v1/course/createcourse
VITE_LESSON_URL=/api/v1/course/uploadlessons
VITE_GETCOURSE_URL=/api/v1/course/getCourseData
VITE_GETCOURSE_LESSONS_URL=/api/v1/course/getCourseAndLessonData

# ---- Subscriptions ----
VITE_ISPRESENT_URL=/api/v1/course/isSubscribed
VITE_ADDSUBSCRIPTION_URL=/api/v1/course/addStudentToCourse
