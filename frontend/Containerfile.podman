FROM node:20-alpine AS build

ENV PNPM_HOME=/pnpm     PATH=/pnpm:$PATH

RUN corepack enable && corepack prepare pnpm@10.12.1 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ARG VITE_SIGNUP_USER
ARG VITE_LOGIN_USER
ARG VITE_GOOGLE_USER
ARG VITE_AUTHME_URL
ARG VITE_COURSE_ADDTOCOMPLETION_URL
ARG VITE_COURSE_CHECKCOMPLETION_URL
ARG VITE_FINDUSER_URL
ARG VITE_UPDATEPASSWORD_URL
ARG VITE_UPDATEPROFILE_URL
ARG VITE_LOGOUT_USER
ARG VITE_CREATEINSTRUCTOR_URL
ARG VITE_COURSE_URL
ARG VITE_LESSON_URL
ARG VITE_GETCOURSE_URL
ARG VITE_GETINSTRUCTOR_COURSES_URL
ARG VITE_GETCOURSE_LESSONS_URL
ARG VITE_ISPRESENT_URL
ARG VITE_ADDSUBSCRIPTION_URL
ARG VITE_CLOUDNAME
ARG VITE_UPLOADPRESET
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_CLERK_PUBLISHABLE_KEY

RUN pnpm run build

FROM nginx:1.27-alpine AS runtime

RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3   CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
