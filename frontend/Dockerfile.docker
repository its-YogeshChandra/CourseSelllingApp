# syntax=docker/dockerfile:1.7
FROM node:20-alpine AS build

ENV PNPM_HOME=/pnpm     PATH=/pnpm:$PATH

RUN corepack enable && corepack prepare pnpm@10.12.1 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./

RUN --mount=type=cache,id=frontend-pnpm,target=/pnpm/store     pnpm install --frozen-lockfile

COPY . .

ARG VITE_SIGNUP_USER
ARG VITE_LOGIN_USER
ARG VITE_GOOGLE_USER
ARG VITE_AUTHME_URL
ARG VITE_COURSE_ADDTOCOMPLETION_URL
ARG VITE_COURSE_CHECKCOMPLETION_URL
ARG VITE_FINDUSER_URL
ARG VITE_UPDATEPASSWORD_URL
ARG VITE_UPDATEPROFILE_URL
ARG VITE_LOGOUT_USER
ARG VITE_CREATEINSTRUCTOR_URL
ARG VITE_COURSE_URL
ARG VITE_LESSON_URL
ARG VITE_GETCOURSE_URL
ARG VITE_GETINSTRUCTOR_COURSES_URL
ARG VITE_GETCOURSE_LESSONS_URL
ARG VITE_ISPRESENT_URL
ARG VITE_ADDSUBSCRIPTION_URL
ARG VITE_CLOUDNAME
ARG VITE_UPLOADPRESET
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_CLERK_PUBLISHABLE_KEY

# Promote ARGs to ENVs so Vite can read them during build
ENV VITE_SIGNUP_USER=$VITE_SIGNUP_USER
ENV VITE_LOGIN_USER=$VITE_LOGIN_USER
ENV VITE_GOOGLE_USER=$VITE_GOOGLE_USER
ENV VITE_AUTHME_URL=$VITE_AUTHME_URL
ENV VITE_COURSE_ADDTOCOMPLETION_URL=$VITE_COURSE_ADDTOCOMPLETION_URL
ENV VITE_COURSE_CHECKCOMPLETION_URL=$VITE_COURSE_CHECKCOMPLETION_URL
ENV VITE_FINDUSER_URL=$VITE_FINDUSER_URL
ENV VITE_UPDATEPASSWORD_URL=$VITE_UPDATEPASSWORD_URL
ENV VITE_UPDATEPROFILE_URL=$VITE_UPDATEPROFILE_URL
ENV VITE_LOGOUT_USER=$VITE_LOGOUT_USER
ENV VITE_CREATEINSTRUCTOR_URL=$VITE_CREATEINSTRUCTOR_URL
ENV VITE_COURSE_URL=$VITE_COURSE_URL
ENV VITE_LESSON_URL=$VITE_LESSON_URL
ENV VITE_GETCOURSE_URL=$VITE_GETCOURSE_URL
ENV VITE_GETINSTRUCTOR_COURSES_URL=$VITE_GETINSTRUCTOR_COURSES_URL
ENV VITE_GETCOURSE_LESSONS_URL=$VITE_GETCOURSE_LESSONS_URL
ENV VITE_ISPRESENT_URL=$VITE_ISPRESENT_URL
ENV VITE_ADDSUBSCRIPTION_URL=$VITE_ADDSUBSCRIPTION_URL
ENV VITE_CLOUDNAME=$VITE_CLOUDNAME
ENV VITE_UPLOADPRESET=$VITE_UPLOADPRESET
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY

RUN pnpm run build

FROM nginx:1.27-alpine AS runtime

RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3   CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]

